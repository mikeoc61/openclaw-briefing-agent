[Unit]
Description=Collect sanitized SMART data for the OpenClaw briefing
Documentation=file:/usr/local/libexec/openclaw-smart-snapshot

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/openclaw-smart-snapshot.conf
UMask=0022
ExecStart=/usr/local/libexec/openclaw-smart-snapshot --output /var/cache/openclaw-health/disk-smart.json --device ${SMART_DEVICE_1} --device ${SMART_DEVICE_2}

# The collector starts privileged but cannot gain any additional privilege.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO

# Fail closed: reaching any device requires a host-local drop-in at
# /etc/systemd/system/openclaw-smart-snapshot.service.d/devices.conf naming
# this host's nodes. Without it the collector fails loudly rather than running
# root with CAP_SYS_RAWIO against every device on the box. See README.md.
DevicePolicy=closed

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/openclaw-health
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

